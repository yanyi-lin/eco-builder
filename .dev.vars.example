# Cloudflare Worker 本地开发环境变量（请勿提交真实 key）
# 复制为 .dev.vars 后填入实际值
#
# OpenAI 兼容 API 的 base URL。以 DeepSeek 官方 API 为例：
#   https://api.deepseek.com
# 注意：不要带末尾 /，路径 /chat/completions 由程序自动拼接。
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名（需端点支持）。DeepSeek 示例：
#   deepseek-v4-flash
OPENAI_MODEL=deepseek-v4-flash

# API Key（敏感，请勿提交）。DeepSeek key 形如 sk-...
OPENAI_API_KEY=sk-your-key-here
