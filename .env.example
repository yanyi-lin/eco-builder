# 复制为 .env 后填写真实值（.env 已被 .gitignore 忽略，不会提交到仓库）
# 生产部署（宝塔面板）时，这些值写在 ecosystem.config.cjs 的 env 段或面板"环境变量"栏

# OpenAI 兼容 API 配置（DeepSeek / 官方 OpenAI / 第三方网关 / Ollama 均可）
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash
# 真实 key 只填本地 .env，不要提交
OPENAI_API_KEY=sk-your-key-here

# 服务监听端口（宝塔 Node 项目端口需与此一致）
PORT=3000

# 单次响应输出 token 上限（成本护栏，默认 4096）
# MAX_OUTPUT_TOKENS=4096
